# grid: copy to .env and fill what you have. Every sponsor degrades gracefully when its key is empty
# (feature flag + clear log line), so the demo runs with zero keys on real public NYISO prices.
# Never commit .env.

# ---- Daytona: sandboxes for plan simulation + the 30-night backtest fan-out (8 at a time)
# https://app.daytona.io -> Dashboard -> API Keys
DAYTONA_API_KEY=

# ---- AWS Bedrock: the dispatcher LLM (Claude on Bedrock)
# AWS console -> IAM -> user -> Security credentials -> Access keys (or `aws configure export-credentials` for SSO);
# enable model access in Bedrock -> Model access for the region below
AWS_REGION=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# optional: pin a Bedrock model or inference profile id (otherwise discovered)
BEDROCK_MODEL_ID=
BEDROCK_DISCOVER=

# ---- Mistral (optional LLM fallback): https://console.mistral.ai -> API Keys
MISTRAL_API_KEY=
MISTRAL_MODEL=

# ---- Anthropic API (optional LLM fallback): https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ---- Arize: OpenInference tracing + evals. https://app.arize.com -> Space Settings -> Space ID and API Keys
ARIZE_SPACE_ID=
ARIZE_API_KEY=

# ---- ElevenLabs: voice dispatcher (TTS + conversational approval). https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# optional: voice id from https://elevenlabs.io/app/voice-library, TTS model, agent LLM
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
ELEVENLABS_AGENT_LLM=
# optional: phone number (E.164) the voice agent calls for approval
DISPATCH_PHONE=

# ---- SurrealDB Agent Memory (temporal facts). Surreal Cloud: https://surrealdb.com/cloud -> instance -> Connect
# (URL + access token). Empty: local SQLite with the same valid_from/valid_until/superseded_by shape.
SURREAL_URL=
SURREAL_TOKEN=

# ---- Anchor Browser (optional cross-check of the public NYISO page): https://app.anchorbrowser.io -> API key
ANCHOR_API_KEY=
ANCHOR_ENABLED=

# ---- Hatchet (only for host processes; docker compose mints ./data/hatchet/token automatically)
# HATCHET_CLIENT_TOKEN=
# ---- docker compose: point containers at an AgentGlow running on the host instead of the compose one
# AGENTGLOW_URL_DOCKER=http://host.docker.internal:8104
